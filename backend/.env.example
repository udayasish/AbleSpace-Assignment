# Copy to .env and adjust. `.env` is gitignored.

NODE_ENV=development
PORT=4000

# Matches compose.yml credentials. Host port is 5433, not the default 5432,
# so this container can coexist with other local Postgres instances.
DATABASE_URL=postgresql://pyramid:pyramid@localhost:5433/pyramid

# Secret used to sign JWTs. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin, used for CORS
CORS_ORIGIN=http://localhost:3000

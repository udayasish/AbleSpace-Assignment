NODE_ENV=development
PORT=4000

# 127.0.0.1 (not localhost): avoids Docker IPv6 port-forward issues on Windows
DATABASE_URL=postgresql://pyramid:pyramid@127.0.0.1:5433/pyramid

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000
